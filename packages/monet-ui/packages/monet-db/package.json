{
  "name": "@monet-ui/monet-db",
  "version": "0.1.0",
  "description": "Monet — the typed TS bridge to the shared `monet-db` SQLite library. A thin wrapper over an app's database Tauri commands: open/close, schema version, integrity check, optimize, backup, and the container ↔ live-database lifecycle. The LOGIC lives in the Rust crate at ../../crates/monet-db; this is a bridge, not a second implementation.",
  "license": "MIT",
  "author": "Monet / monet-ui",
  "type": "module",
  "sideEffects": false,
  "files": ["dist"],
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": { "types": "./dist/index.d.ts", "import": "./dist/index.js" }
  },
  "scripts": {
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:unit": "vitest run",
    "prepare": "pnpm run build"
  },
  "keywords": ["monet", "sqlite", "database", "tauri", "migrations"],
  "homepage": "https://github.com/monetone/monet/tree/main/packages/monet-ui/packages/monet-db#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/monetone/monet.git",
    "directory": "packages/monet-ui/packages/monet-db"
  },
  "bugs": { "url": "https://github.com/monetone/monet/issues" },
  "publishConfig": { "access": "public" },
  "peerDependencies": {
    "@tauri-apps/api": "^2.0.0"
  },
  "peerDependenciesMeta": {
    "@tauri-apps/api": { "optional": true }
  },
  "devDependencies": {
    "@tauri-apps/api": "^2.1.1",
    "typescript": "^5.6.3",
    "vitest": "^4.1.8"
  }
}
