{
  "name": "@monet-ui/monet-react",
  "version": "0.1.0",
  "description": "Monet — the liquid-glass panel design system as React components, with Tauri 2 window integration",
  "license": "MIT",
  "author": "Monet / monet-ui",
  "type": "module",
  "//": "dist/ is built fresh by the prepublishOnly script, so `npm publish` from a clean checkout always ships a current build. Building the core dep first lets this package's dts resolve @monet-ui/monet-core from its dist.",
  "sideEffects": false,
  "files": ["dist"],
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "typecheck": "tsc --noEmit",
    "test:dom": "vitest run",
    "test:unit": "vitest run",
    "test:watch": "vitest",
    "prepare": "pnpm run build",
    "prepublishOnly": "pnpm --filter @monet-ui/monet-core run build && pnpm run build"
  },
  "keywords": [
    "tauri",
    "design-system",
    "liquid-glass",
    "react",
    "panels",
    "dockable"
  ],
  "homepage": "https://github.com/monetone/monet/tree/main/packages/monet-ui/packages/monet-react#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/monetone/monet.git",
    "directory": "packages/monet-ui/packages/monet-react"
  },
  "bugs": {
    "url": "https://github.com/monetone/monet/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "peerDependencies": {
    "react": "^18.3.0",
    "react-dom": "^18.3.0"
  },
  "dependencies": {
    "@monet-ui/monet-core": "workspace:*",
    "@tauri-apps/api": "^2.1.1",
    "@tauri-apps/plugin-dialog": "^2.7.1",
    "@tauri-apps/plugin-fs": "^2.5.1"
  },
  "devDependencies": {
    "@testing-library/dom": "^10.4.1",
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^22.10.0",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^5.2.0",
    "jsdom": "^29.1.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tsup": "^8.3.5",
    "typescript": "^5.6.3",
    "vitest": "^4.1.8"
  }
}
