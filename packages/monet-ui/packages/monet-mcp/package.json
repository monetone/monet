{
  "name": "@monet-ui/monet-mcp",
  "version": "0.1.0",
  "description": "Monet — shared Model Context Protocol (MCP) bridge for every Monet app. A pure MCP/JSON-RPC server core, a Tauri event bridge that exposes the running app over a local HTTP endpoint, and a build-time codegen that turns @mcp-annotated commands into MCP tools so new features get MCP support automatically.",
  "license": "MIT",
  "author": "Monet / monet-ui",
  "type": "module",
  "sideEffects": false,
  "files": ["dist"],
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "bin": {
    "monet-mcp-codegen": "./dist/cli.js"
  },
  "exports": {
    ".": { "types": "./dist/index.d.ts", "import": "./dist/index.js" },
    "./codegen": { "types": "./dist/codegen.d.ts", "import": "./dist/codegen.js" }
  },
  "scripts": {
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "test:unit": "vitest run",
    "test": "vitest run",
    "prepare": "pnpm run build"
  },
  "peerDependencies": {
    "@tauri-apps/api": "^2.0.0",
    "typescript": "^5.0.0"
  },
  "peerDependenciesMeta": {
    "@tauri-apps/api": { "optional": true },
    "typescript": { "optional": true }
  },
  "devDependencies": {
    "@tauri-apps/api": "^2.1.1",
    "@types/node": "^22.10.0",
    "typescript": "^5.6.3",
    "vitest": "^4.1.8"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/monetone/monet.git",
    "directory": "packages/monet-ui/packages/monet-mcp"
  },
  "publishConfig": { "access": "public" }
}
