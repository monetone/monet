{
  "name": "@monet-ui/monet-imageio",
  "version": "0.1.0",
  "description": "Monet — framework-free image & swatch codecs: TGA / PNM(PBM,PGM,PPM) / PCX raster, ACO / ASE / ACT color swatch exchange, and PDF/SVG export builders. Pure functions over typed arrays; no DOM. Shared across the Monet photo apps.",
  "license": "MIT",
  "author": "Monet / monet-ui",
  "type": "module",
  "//": "Framework-agnostic: NO React/DOM imports, so it runs in node/workers too. Pure functions over typed arrays. dist/ is built fresh by prepare/prepublishOnly.",
  "sideEffects": false,
  "files": ["dist"],
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": { ".": { "types": "./dist/index.d.ts", "import": "./dist/index.js" } },
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:unit": "vitest run",
    "test:watch": "vitest",
    "prepare": "pnpm run build",
    "prepublishOnly": "pnpm run build"
  },
  "keywords": ["codec", "image", "tga", "pnm", "pcx", "aco", "ase", "act", "swatches", "photo", "monet"],
  "homepage": "https://github.com/monetone/monet/tree/main/packages/monet-ui/packages/monet-imageio#readme",
  "repository": { "type": "git", "url": "git+https://github.com/monetone/monet.git", "directory": "packages/monet-ui/packages/monet-imageio" },
  "bugs": { "url": "https://github.com/monetone/monet/issues" },
  "publishConfig": { "access": "public" },
  "dependencies": { "@monet-ui/monet-color": "workspace:*" },
  "devDependencies": { "tsup": "^8.3.5", "typescript": "^5.6.3", "vitest": "^4.1.8" }
}
