{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Monet Motion",
  "version": "0.1.0",
  "identifier": "dev.monet.motion",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:1424",
    "beforeDevCommand": "pnpm vite --port 1424 --strictPort",
    "beforeBuildCommand": "pnpm vite build"
  },
  "app": {
    "withGlobalTauri": false,
    "macOSPrivateApi": true,
    "windows": [],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
