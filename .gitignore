# Dependencies
node_modules/
.pnpm-store/

# Build output
dist/
**/dist/
*.tsbuildinfo

# Rust / Cargo / Tauri
target/
**/src-tauri/target/
**/engine/target/
**/crates/**/target/

# WASM engine build output (regenerated via `pnpm engine:build`)
**/engine/pkg/

# wasm-pack output for the shared monet-format crate (regenerated on build)
packages/monet-ui/packages/monet-format/wasm/

# Release artifacts (regenerated by tauri build / scripts/release-build-all.sh)
release-dmgs/

# Test output
test-results/
playwright-report/
**/playwright/.cache/

# Misc
.DS_Store
*.log
.env
.env.*
!.env.example

# Spurious nested lockfile (the in-tree Monet UI has its own pnpm-workspace.yaml);
# the monorepo uses the root lockfile only.
packages/monet-ui/pnpm-lock.yaml

# Collab sync-server persisted room state (runtime artifact)
.collab-data/

# icon generation scratch (round 1 samplers)
icon-lab/

# Private third-party UI reference captures must not enter public source history.
docs/lightroom-classic/*.jpeg

# Agent tooling runtime state (Claude Code, OMX, OMC, OMO)
.claude/
.omx/
.omc/
.omo/

# Git worktrees
.worktrees/

# C2PA development signer. Vision generates this pair at build time.
# Never commit a private key.
apps/vision/src-tauri/certs/*.pem
