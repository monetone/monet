{
  "name": "monet-galerie",
  "private": true,
  "license": "MIT",
  "version": "0.1.0",
  "type": "module",
  "description": "Monet Galerie — a liquid-glass photo catalog & non-destructive RAW develop studio (Lightroom Classic-class), built on Tauri 2 + Monet UI.",
  "scripts": {
    "dev": "vite",
    "engine:build": "wasm-pack build ../../packages/engine --target web --out-dir ../../apps/galerie/engine/pkg --dev",
    "engine:build:release": "wasm-pack build ../../packages/engine --target web --out-dir ../../apps/galerie/engine/pkg --release",
    "engine:require": "node scripts/require-engine.mjs",
    "build": "pnpm engine:require && tsc --noEmit && vite build",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "test:unit": "vitest run",
    "test:shared-core-wasm": "node scripts/shared-core-develop-proof.mjs",
    "test:shared-core-product": "node --test scripts/shared-core-product-proof-contract.mjs && node scripts/shared-core-product-proof.mjs",
    "test:engine-require": "node --test scripts/require-engine-proof.mjs",
    "proof:raw-acquire": "node scripts/raw-proof.mjs acquire",
    "proof:colorchecker": "node scripts/raw-proof.mjs color",
    "test:colorchecker-proof": "node --test scripts/colorchecker-proof-contract.mjs",
    "test:raw-orientation": "node scripts/raw-orientation-proof.mjs",
    "proof:product-export": "node --test scripts/product-export-proof-contract.mjs && node scripts/product-export-proof.mjs",
    "proof:dng": "node --test scripts/dng-proof-contract.mjs && node scripts/dng-proof.mjs",
    "test:product-export-contract": "node --test scripts/product-export-proof-contract.mjs",
    "test:develop-route-contract": "cargo check --manifest-path src-tauri/Cargo.toml && node --test scripts/develop-route-contract.mjs",
    "test:mvsn-v15-provenance": "node scripts/verify-mvsn-v15-provenance.mjs",
    "test:format-baseline": "node scripts/verify-engine-format-baseline.mjs",
    "test:secondary-window": "node scripts/secondary-window-proof.mjs",
    "test:watch": "vitest",
    "mcp:codegen": "monet-mcp-codegen",
    "mcp:check": "monet-mcp-codegen --check",
    "preview": "vite preview",
    "tauri": "tauri"
  },
  "dependencies": {
    "@monet-ui/monet-color": "workspace:*",
    "@monet-ui/monet-core": "workspace:*",
    "@monet-ui/monet-format": "workspace:*",
    "@monet-ui/monet-imageio": "workspace:*",
    "@monet-ui/monet-mcp": "workspace:*",
    "@monet-ui/monet-photo": "workspace:*",
    "@monet-ui/monet-react": "workspace:*",
    "@monet-ui/monet-scopes": "workspace:*",
    "@tauri-apps/api": "^2.1.1",
    "@tauri-apps/plugin-dialog": "^2.7.1",
    "@tauri-apps/plugin-fs": "^2",
    "onnxruntime-web": "1.26.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@tauri-apps/cli": "^2.1.0",
    "@types/node": "^22.10.0",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "eslint": "^10.5.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.6.0",
    "typescript": "^5.6.3",
    "typescript-eslint": "^8.61.0",
    "vite": "^6.0.7",
    "vitest": "^4.1.8"
  }
}
