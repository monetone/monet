{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Monet Jouer",
  "version": "0.1.0",
  "identifier": "dev.monet.jouer",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:1423",
    "beforeDevCommand": "pnpm vite --port 1423 --strictPort",
    "beforeBuildCommand": "pnpm run build:release"
  },
  "app": {
    "withGlobalTauri": false,
    "macOSPrivateApi": true,
    "windows": [],
    "security": {
      "csp": "default-src 'self'; img-src 'self' data: blob:; media-src 'self' blob: data:; font-src 'self' data:; style-src 'self' 'unsafe-inline'; script-src 'self' blob:; connect-src 'self' ipc: http://ipc.localhost ws://localhost:1423 http://localhost:1423 blob: data: https://cdn.jsdelivr.net https://data.jsdelivr.com; worker-src 'self' blob:; child-src 'self' blob:; object-src 'none'; base-uri 'self'; frame-ancestors 'none'"
    }
  },
  "bundle": {
    "active": true,
    "macOS": {
      "bundleName": "Jouer"
    },
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "fileAssociations": [
      {
        "ext": [
          "mjou"
        ],
        "name": "Monet Jouer Project",
        "description": "Monet Jouer Project",
        "role": "Editor"
      },
      {
        "ext": [
          "mvis",
          "mart",
          "mgal",
          "mcin",
          "mani",
          "mryt"
        ],
        "name": "Monet Document",
        "description": "Monet document from another app",
        "role": "Viewer"
      }
    ]
  }
}
