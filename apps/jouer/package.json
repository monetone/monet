{
  "name": "monet-jouer",
  "private": true,
  "license": "MIT",
  "version": "0.1.0",
  "type": "module",
  "description": "Monet Jouer — a liquid-glass 2D game & animation editor (Unity-class, open-source) built on Monet UI with a live Phaser game engine and Phaser code export.",
  "packageManager": "pnpm@11.1.3",
  "engines": {
    "node": ">=20",
    "pnpm": ">=9"
  },
  "scripts": {
    "build:libs": "pnpm --filter @monet-ui/monet-core build && pnpm --filter @monet-ui/monet-react build",
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "build:release": "pnpm run build:libs && pnpm run build",
    "typecheck": "tsc --noEmit",
    "mcp:codegen": "monet-mcp-codegen",
    "mcp:check": "monet-mcp-codegen --check",
    "lint": "eslint .",
    "test:unit": "vitest run",
    "test:watch": "vitest",
    "build:e2e": "MJ_EXPOSE=1 vite build",
    "preview:e2e": "vite preview --host 127.0.0.1 --port 1430 --strictPort",
    "test:e2e": "playwright test",
    "test:e2e:headed": "playwright test --headed",
    "test": "pnpm run test:unit && pnpm run test:e2e",
    "preview": "vite preview",
    "verify": "pnpm run typecheck && pnpm run lint && pnpm run test:unit && pnpm run build",
    "tauri": "tauri"
  },
  "dependencies": {
    "@monet-ui/monet-collab": "workspace:*",
    "@monet-ui/monet-core": "workspace:*",
    "@monet-ui/monet-format": "workspace:*",
    "@monet-ui/monet-mcp": "workspace:*",
    "@monet-ui/monet-react": "workspace:*",
    "@tauri-apps/api": "^2.1.1",
    "@tauri-apps/plugin-dialog": "^2",
    "@tauri-apps/plugin-fs": "^2",
    "phaser": "^4.1.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.60.0",
    "@tauri-apps/cli": "^2.1.0",
    "@types/node": "^22.10.0",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "eslint": "^10.5.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.6.0",
    "typescript": "^5.6.3",
    "typescript-eslint": "^8.61.0",
    "vite": "^6.0.7",
    "vitest": "^4.1.8"
  }
}
