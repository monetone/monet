{
  "name": "monet-vision",
  "private": true,
  "license": "MIT",
  "version": "0.1.0",
  "type": "module",
  "description": "Monet Vision \u2014 a Photoshop-class raster image editor built on Monet UI with a Rust/WASM rendering engine.",
  "packageManager": "pnpm@11.1.3",
  "engines": {
    "node": ">=20",
    "pnpm": ">=9"
  },
  "scripts": {
    "build:libs": "pnpm --filter 'monet-vision^...' run build",
    "engine:build": "wasm-pack build ../../packages/engine --target web --out-dir ../../apps/vision/engine/pkg --dev",
    "engine:build:release": "wasm-pack build ../../packages/engine --target web --out-dir ../../apps/vision/engine/pkg --release",
    "bench:wasm": "node scripts/wasm-bench.mjs",
    "dev": "vite",
    "build": "pnpm run typecheck && vite build",
    "build:release": "pnpm run build:libs && pnpm run mcp:check && pnpm run check:models && pnpm run check:ort && pnpm run engine:build:release && pnpm run build && pnpm run verify:bundle",
    "verify:bundle": "node scripts/verify-release-bundle.mjs",
    "verify:release": "pnpm run build:release",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.node.json",
    "mcp:codegen": "monet-mcp-codegen",
    "mcp:check": "monet-mcp-codegen --check",
    "lint": "eslint .",
    "check:models": "node scripts/check-model-licenses.mjs",
    "check:ort": "node scripts/check-ort-runtime.mjs",
    "test:unit": "vitest run --maxWorkers=4 --testTimeout=30000 --hookTimeout=30000",
    "test:coverage": "vitest run --coverage --maxWorkers=1",
    "test:native": "cargo test --locked --manifest-path src-tauri/Cargo.toml && tauri build --no-bundle --ci",
    "preview": "vite preview",
    "build:e2e": "vite build --mode e2e",
    "preview:e2e": "vite preview --host 127.0.0.1 --port 1430 --strictPort",
    "test:e2e": "playwright test",
    "test:e2e:desktop": "playwright test --project=desktop",
    "test:e2e:native": "node scripts/native-webview-e2e.mjs",
    "test:e2e:headed": "playwright test --headed",
    "tauri": "tauri"
  },
  "dependencies": {
    "@jsquash/avif": "^2.1.1",
    "@jsquash/webp": "^1.5.0",
    "@monet-ui/monet-collab": "workspace:*",
    "@monet-ui/monet-color": "workspace:*",
    "@monet-ui/monet-core": "workspace:*",
    "@monet-ui/monet-format": "workspace:*",
    "@monet-ui/monet-imageio": "workspace:*",
    "@monet-ui/monet-mcp": "workspace:*",
    "@monet-ui/monet-photo": "workspace:*",
    "@monet-ui/monet-react": "workspace:*",
    "@monet-ui/monet-scopes": "workspace:*",
    "@tauri-apps/api": "^2.1.1",
    "@tauri-apps/plugin-dialog": "^2",
    "@tauri-apps/plugin-fs": "^2",
    "@tauri-apps/plugin-opener": "^2.7.0",
    "onnxruntime-web": "1.26.0",
    "pdfjs-dist": "^6.1.200",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.60.0",
    "@tauri-apps/cli": "^2.1.0",
    "@types/node": "^22.10.0",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@types/react-test-renderer": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "@vitest/coverage-v8": "4.1.9",
    "ag-psd": "^30.1.1",
    "eslint": "^10.5.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.6.0",
    "react-test-renderer": "18.3.1",
    "typescript": "^5.6.3",
    "typescript-eslint": "^8.61.0",
    "vite": "^6.0.7",
    "vitest": "4.1.9"
  }
}
