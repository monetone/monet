{
  "name": "monet-rythme",
  "private": true,
  "license": "MIT",
  "version": "0.1.0",
  "type": "module",
  "description": "Monet Rythme — a liquid-glass digital audio workstation (Adobe Audition / Audacity-class), built on Tauri 2 + Monet UI.",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "preview": "vite preview",
    "test": "vitest run",
    "test:unit": "vitest run",
    "test:watch": "vitest",
    "fixtures": "node scripts/fixtures/generate.mjs",
    "fixtures:fetch": "node scripts/fixtures/fetch-online.mjs",
    "e2e": "node scripts/e2e/run-all.mjs",
    "mcp:codegen": "monet-mcp-codegen",
    "mcp:check": "monet-mcp-codegen --check",
    "tauri": "tauri"
  },
  "dependencies": {
    "@monet-ui/monet-collab": "workspace:*",
    "@monet-ui/monet-core": "workspace:*",
    "@monet-ui/monet-format": "workspace:*",
    "@monet-ui/monet-mcp": "workspace:*",
    "@monet-ui/monet-react": "workspace:*",
    "@monet-ui/monet-timeline": "workspace:*",
    "@tauri-apps/api": "^2.1.1",
    "@tauri-apps/plugin-dialog": "^2.7.1",
    "@tauri-apps/plugin-fs": "^2.5.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@tauri-apps/cli": "^2.1.0",
    "@types/node": "^22.10.0",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "eslint": "^10.5.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.6.0",
    "playwright-core": "^1.60.0",
    "typescript": "^5.6.3",
    "typescript-eslint": "^8.61.0",
    "vite": "^6.0.7",
    "vitest": "^2.1.8"
  }
}
