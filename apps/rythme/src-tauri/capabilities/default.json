{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Default capability for the Monet Rythme window",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "core:window:allow-start-dragging",
    "atomicsave:default",
    "dialog:default",
    "fs:read-all",
    "fs:write-all",
    {
      "identifier": "fs:scope",
      "allow": [{ "path": "**" }],
      "deny": [
        { "path": "$HOME/.ssh/**" },
        { "path": "$HOME/.aws/**" },
        { "path": "$HOME/.gnupg/**" },
        { "path": "$HOME/.config/**" },
        { "path": "$HOME/.docker/**" },
        { "path": "$HOME/.kube/**" },
        { "path": "$HOME/Library/Keychains/**" }
      ]
    }
  ]
}
