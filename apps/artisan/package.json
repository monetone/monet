{
  "name": "monet-artisan",
  "private": true,
  "license": "MIT",
  "version": "0.1.0",
  "type": "module",
  "description": "Monet Artisan — a liquid-glass vector illustration studio (Adobe Illustrator-class), built on Tauri 2 + Monet UI.",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "typecheck": "tsc --noEmit",
    "mcp:codegen": "monet-mcp-codegen",
    "mcp:check": "monet-mcp-codegen --check",
    "engine:build": "wasm-pack build ../../packages/engine --target web --out-dir ../../apps/artisan/engine/pkg --dev",
    "engine:build:release": "wasm-pack build ../../packages/engine --target web --out-dir ../../apps/artisan/engine/pkg --release",
    "lint": "eslint .",
    "verify": "pnpm typecheck && pnpm lint && pnpm test && pnpm build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:unit": "vitest run",
    "test:watch": "vitest",
    "e2e": "node scripts/e2e/run-all.mjs",
    "e2e:svg": "node scripts/e2e/svg-fixtures.mjs",
    "e2e:qa": "node scripts/e2e/qa.mjs",
    "e2e:raster": "node scripts/e2e/raster.mjs",
    "e2e:all": "node scripts/e2e/run-all.mjs && node scripts/e2e/svg-fixtures.mjs && node scripts/e2e/qa.mjs && node scripts/e2e/raster.mjs",
    "e2e:desktop": "node scripts/e2e/desktop-smoke.mjs",
    "e2e:desktop:linux": "node scripts/e2e/desktop-tauri.mjs",
    "tauri": "tauri"
  },
  "packageManager": "pnpm@11.1.3",
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@monet-ui/monet-collab": "workspace:*",
    "@monet-ui/monet-core": "workspace:*",
    "@monet-ui/monet-format": "workspace:*",
    "@monet-ui/monet-imageio": "workspace:*",
    "@monet-ui/monet-mcp": "workspace:*",
    "@monet-ui/monet-react": "workspace:*",
    "@monet-ui/monet-scopes": "workspace:*",
    "@tauri-apps/api": "^2.1.1",
    "@tauri-apps/plugin-dialog": "^2.7.1",
    "@tauri-apps/plugin-fs": "^2.5.1",
    "immer": "^11.1.8",
    "polygon-clipping": "^0.15.7",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@tauri-apps/cli": "^2.1.0",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "eslint": "^10.5.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.6.0",
    "happy-dom": "^20.10.3",
    "playwright-core": "^1.60.0",
    "selenium-webdriver": "^4.27.0",
    "typescript": "^5.6.3",
    "typescript-eslint": "^8.61.0",
    "vite": "^6.0.7",
    "vitest": "^2.1.8"
  }
}
